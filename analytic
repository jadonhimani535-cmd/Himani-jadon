8. Overall placement statistics
Summarize total, placed, unplaced, and placement percentage.
SELECT COUNT(*) AS total_students,
COUNT(*) FILTER (WHERE EXISTS (
SELECT 1 FROM placements p
WHERE p.student_id = s.student_id AND p.placement_status = 'Placed'
)) AS placed_students,
COUNT(*) FILTER (WHERE NOT EXISTS (
SELECT 1 FROM placements p
WHERE p.student_id = s.student_id AND p.placement_status = 'Placed'
)) AS unplaced_students,
ROUND(100.0 * COUNT(*) FILTER (WHERE EXISTS (
SELECT 1 FROM placements p
WHERE p.student_id = s.student_id AND p.placement_status = 'Placed'
)) / NULLIF(COUNT(*), 0), 2) AS placement_percentage
FROM students s;
9. Average CGPA of placed students
Average CGPA for students with a successful placement.
SELECT ROUND(AVG(s.cgpa), 2) AS average_cgpa_of_placed_students
FROM students s
WHERE EXISTS (
SELECT 1 FROM placements p
WHERE p.student_id = s.student_id AND p.placement_status = 'Placed'
);
10. Branch-wise average CGPA of placed students
Compare CGPA among placed students by branch.
SELECT s.branch, COUNT(*) AS placed_students,
ROUND(AVG(s.cgpa), 2) AS average_cgpa
FROM students s
WHERE EXISTS (
SELECT 1 FROM placements p
WHERE p.student_id = s.student_id AND p.placement_status = 'Placed'
)
GROUP BY s.branch
ORDER BY average_cgpa DESC;
11. List unplaced students
Find students without any successful placement.
SELECT s.student_id, s.student_name, s.branch, s.cgpa, s.skills
FROM students s
WHERE NOT EXISTS (
SELECT 1 FROM placements p
WHERE p.student_id = s.student_id AND p.placement_status = 'Placed'
)
ORDER BY s.cgpa DESC NULLS LAST;
12. Company-wise hiring count
Count placed students hired by each company.
SELECT company_name, COUNT(DISTINCT student_id) AS students_hired
FROM placements
WHERE placement_status = 'Placed'
GROUP BY company_name
ORDER BY students_hired DESC, company_name;
13. Company-wise average and highest package
Summarize package values for each company.
SELECT company_name,
COUNT(DISTINCT student_id) AS students_hired,
ROUND(AVG(package_lpa), 2) AS average_package_lpa,
MAX(package_lpa) AS highest_package_lpa
FROM placements
WHERE placement_status = 'Placed'
GROUP BY company_name
ORDER BY highest_package_lpa DESC NULLS LAST;
14. Highest package by branch
Find the highest package recorded in each branch.
SELECT s.branch, MAX(p.package_lpa) AS highest_package_lpa
FROM students s
JOIN placements p ON p.student_id = s.student_id
WHERE p.placement_status = 'Placed'
GROUP BY s.branch
ORDER BY highest_package_lpa DESC NULLS LAST;
