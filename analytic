15. Average package by branch
Compare average packages across branches.
SELECT s.branch, ROUND(AVG(p.package_lpa), 2) AS average_package_lpa
FROM students s
JOIN placements p ON p.student_id = s.student_id
WHERE p.placement_status = 'Placed'
GROUP BY s.branch
ORDER BY average_package_lpa DESC;
16. Placement records by year
Count placements by calendar year.
SELECT EXTRACT(YEAR FROM placement_date)::INT AS placement_year,
COUNT(DISTINCT student_id) AS students_placed
FROM placements
WHERE placement_status = 'Placed' AND placement_date IS NOT NULL
GROUP BY EXTRACT(YEAR FROM placement_date)
ORDER BY placement_year;
17. Recent placements
Show the most recent placement records first.
SELECT p.placement_id, s.student_name, s.branch,
p.company_name, p.package_lpa, p.placement_date
FROM placements p
JOIN students s ON s.student_id = p.student_id
WHERE p.placement_status = 'Placed'
ORDER BY p.placement_date DESC NULLS LAST
LIMIT 10;
18. Students with multiple placement offers
Find students with multiple successful placement records.
SELECT s.student_id, s.student_name, COUNT(*) AS placed_records
FROM students s
JOIN placements p ON p.student_id = s.student_id
WHERE p.placement_status = 'Placed'
GROUP BY s.student_id, s.student_name
HAVING COUNT(*) > 1
ORDER BY placed_records DESC;
19. Students above branch average CGPA
Identify students above their branch's average CGPA.
SELECT s.student_id, s.student_name, s.branch, s.cgpa
FROM students s
JOIN (
SELECT branch, AVG(cgpa) AS branch_avg_cgpa
FROM students
GROUP BY branch
) b ON b.branch = s.branch
WHERE s.cgpa > b.branch_avg_cgpa
ORDER BY s.branch, s.cgpa DESC;
20. Placement status summary
Count placement records by status.
SELECT placement_status, COUNT(*) AS record_count
FROM placements
GROUP BY placement_status
ORDER BY record_count DESC;
21. Students with missing CGPA
Find records needing academic data completion.
SELECT student_id, student_name, branch
FROM students
WHERE cgpa IS NULL
ORDER BY branch, student_name;
22. Students with missing skills
Find profiles with blank or null skill information.
SELECT student_id, student_name, branch
FROM students
WHERE skills IS NULL OR BTRIM(skills) = ''
ORDER BY branch, student_name;
