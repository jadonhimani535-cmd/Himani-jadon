24. Branch-wise unplaced student count
Count students without a successful placement by branch.
SELECT s.branch, COUNT(*) AS unplaced_students
FROM students s
WHERE NOT EXISTS (
SELECT 1 FROM placements p
WHERE p.student_id = s.student_id AND p.placement_status = 'Placed'
)
GROUP BY s.branch
ORDER BY unplaced_students DESC;
25. Top 5 placed students by package
Rank placed students by their recorded package.
SELECT s.student_name, s.branch, p.company_name, p.package_lpa
FROM students s
JOIN placements p ON p.student_id = s.student_id
WHERE p.placement_status = 'Placed'
ORDER BY p.package_lpa DESC NULLS LAST
LIMIT 5;
26. Package distribution bands
Count placements in package ranges.
SELECT CASE
WHEN package_lpa < 3 THEN 'Below 3 LPA'
WHEN package_lpa < 6 THEN '3 to below 6 LPA'
WHEN package_lpa < 10 THEN '6 to below 10 LPA'
ELSE '10 LPA and above'
END AS package_band,
COUNT(*) AS placement_count
FROM placements
WHERE placement_status = 'Placed' AND package_lpa IS NOT NULL
GROUP BY package_band
ORDER BY MIN(package_lpa);
27. Branch and company hiring matrix
Show students hired by each company from each branch.
SELECT s.branch, p.company_name, COUNT(DISTINCT s.student_id) AS students_hired
FROM students s
JOIN placements p ON p.student_id = s.student_id
WHERE p.placement_status = 'Placed'
GROUP BY s.branch, p.company_name
ORDER BY s.branch, students_hired DESC;
28. Placement rate by graduation year
Calculate placement percentage for each graduating cohort.
SELECT s.graduation_year,
COUNT(*) AS total_students,
COUNT(*) FILTER (WHERE EXISTS (
SELECT 1 FROM placements p
WHERE p.student_id = s.student_id AND p.placement_status = 'Placed'
)) AS placed_students,
ROUND(100.0 * COUNT(*) FILTER (WHERE EXISTS (
SELECT 1 FROM placements p
WHERE p.student_id = s.student_id AND p.placement_status = 'Placed'
)) / NULLIF(COUNT(*), 0), 2) AS placement_percentage
FROM students s
GROUP BY s.graduation_year
ORDER BY s.graduation_year;
29. Students with a particular skill keyword
Example: search student skill text for Python.
SELECT student_id, student_name, branch, skills
FROM students
WHERE skills ILIKE '%Python%'
ORDER BY branch, student_name;
